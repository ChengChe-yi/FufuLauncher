<Window
    x:Class="FufuLauncher.Views.BackpackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:FufuLauncher.Views"
    xmlns:vm="using:FufuLauncher.ViewModels"
    xmlns:helpers="using:FufuLauncher.Helpers"
    mc:Ignorable="d"
    Title="{helpers:Loc Key=BackpackWindow_Title}">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="MainContent">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="AppBackground" Color="#FFF3F3F3"/>
                        <SolidColorBrush x:Key="SidebarBackground" Color="#FFF9F9F9"/>
                        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF"/>
                        <SolidColorBrush x:Key="CardBorder" Color="#FFE5E5E5"/>
                        <SolidColorBrush x:Key="HighlightColor" Color="#FF000000"/>
                        <SolidColorBrush x:Key="SubTextColor" Color="#FF666666"/>
                        <SolidColorBrush x:Key="ImageBackgroundBrush" Color="#0D000000"/>
                        <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#1A000000"/>
                        <SolidColorBrush x:Key="SeparatorBrush" Color="#1A000000"/>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="AppBackground" Color="#FF1E1E1E"/>
                        <SolidColorBrush x:Key="SidebarBackground" Color="#FF252526"/>
                        <SolidColorBrush x:Key="CardBackground" Color="#FF2D2D30"/>
                        <SolidColorBrush x:Key="CardBorder" Color="#FF3E3E42"/>
                        <SolidColorBrush x:Key="HighlightColor" Color="#FFECECEC"/>
                        <SolidColorBrush x:Key="SubTextColor" Color="#FFAAAAAA"/>
                        <SolidColorBrush x:Key="ImageBackgroundBrush" Color="#33000000"/>
                        <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#33FFFFFF"/>
                        <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="{ThemeResource HighlightColor}"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>

                <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource CardBorder}"/>
                    <Setter Property="Foreground" Value="{ThemeResource SubTextColor}"/>
                    <Setter Property="Padding" Value="12,5"/>
                    <Setter Property="CornerRadius" Value="14"/>
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Grid>
                                    <Border x:Name="ChipRest"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{TemplateBinding CornerRadius}"/>
                                    <Border x:Name="ChipAccent"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            Opacity="0"/>
                                    <ContentPresenter x:Name="ChipContent"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalContentAlignment="Center"
                                                      VerticalContentAlignment="Center"
                                                      Padding="{TemplateBinding Padding}"/>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipContent" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource HighlightColor}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ChipAccent" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.1"/>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Checked">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ChipAccent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipContent" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="CheckedPointerOver">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ChipAccent" Storyboard.TargetProperty="Opacity" To="0.86" Duration="0:0:0.16"/>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipContent" Storyboard.TargetProperty="Foreground">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ChipRest" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="SidebarListItemContainerStyle" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Grid x:Name="Root" Background="Transparent">
                                    <ContentPresenter
                                        x:Name="ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="CardListItemContainerStyle" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Padding="{TemplateBinding Padding}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="CardButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <DataTemplate x:Key="BackpackSidebarItemTemplate" x:DataType="vm:BackpackSidebarEntry">
                    <Grid Height="48" ColumnSpacing="12" CornerRadius="8" Margin="8,1" Padding="12,0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{ThemeResource BadgeBackgroundBrush}">
                            <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{ThemeResource HighlightColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" Foreground="{ThemeResource HighlightColor}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind CountLabel, Mode=OneWay}" Foreground="{ThemeResource SubTextColor}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="BackpackSummaryStatTemplate" x:DataType="vm:BackpackSummaryStat">
                    <Border Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="4" Padding="10,4" Margin="6,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{ThemeResource HighlightColor}"/>
                            <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubTextColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <DataTemplate x:Key="CompactWeaponTemplate" x:DataType="vm:WeaponViewModel">
                    <Grid Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,12,14,12" MinHeight="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="56" Height="56" CornerRadius="10">
                            <Image Source="{x:Bind QualitySource}" Stretch="Fill"/>
                            <Image Source="ms-appx:///Assets/Backpack/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill"/>
                            <local:DeferredImage Width="50" Height="50" SourceUri="{x:Bind IconUri}" DecodePixelWidth="64"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Source.Name}" Foreground="{ThemeResource HighlightColor}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind RankDisplay}" FontSize="11" Foreground="{StaticResource WeaponGoldBrush}" CharacterSpacing="60"/>
                            <TextBlock Text="{x:Bind Source.Type}" Foreground="{ThemeResource SubTextColor}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                            <Border Padding="10,3" CornerRadius="6" Background="{ThemeResource BadgeBackgroundBrush}" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind LevelFull}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                            </Border>
                            <Border Padding="10,3" CornerRadius="6" Background="{ThemeResource BadgeBackgroundBrush}" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind RefineLabel}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="CompactArtifactTemplate" x:DataType="vm:ArtifactViewModel">
                    <Grid Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,12,14,12" MinHeight="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="56" Height="56" CornerRadius="10">
                            <Image Source="{x:Bind QualitySource}" Stretch="Fill"/>
                            <Image Source="ms-appx:///Assets/Backpack/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill"/>
                            <local:DeferredImage Width="50" Height="50" SourceUri="{x:Bind IconUri}" DecodePixelWidth="64"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Source.SetName}" Foreground="{ThemeResource HighlightColor}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind RankDisplay}" FontSize="11" Foreground="{StaticResource WeaponGoldBrush}" CharacterSpacing="60"/>
                            <TextBlock Text="{x:Bind Source.Name}" Foreground="{ThemeResource SubTextColor}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                            <Border Padding="10,3" CornerRadius="6" Background="{ThemeResource BadgeBackgroundBrush}" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind SlotRankEquipped}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                            </Border>
                            <Border Padding="10,3" CornerRadius="6" Background="{ThemeResource BadgeBackgroundBrush}" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind Level}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="CompactFoodTemplate" x:DataType="vm:FoodViewModel">
                    <Grid Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,12,14,12" MinHeight="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="56" Height="56" CornerRadius="10">
                            <Image Source="{x:Bind QualitySource}" Stretch="Fill"/>
                            <Image Source="ms-appx:///Assets/Backpack/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill"/>
                            <local:DeferredImage Width="50" Height="50" SourceUri="{x:Bind IconUri}" DecodePixelWidth="64"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource HighlightColor}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind VariantLabel}" FontSize="12" Foreground="{x:Bind VariantForeground}"/>
                                <TextBlock Text="{x:Bind Character}" FontSize="12" Foreground="{ThemeResource SubTextColor}" Visibility="{x:Bind CharacterVisibility}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                            <Border Padding="12,3" CornerRadius="6" Background="{ThemeResource BadgeBackgroundBrush}" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind Count}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="CompactSimpleTemplate" x:DataType="vm:SimpleItemViewModel">
                    <Grid Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12,12,14,12" MinHeight="72">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Width="56" Height="56" CornerRadius="10">
                            <Image Source="{x:Bind QualitySource}" Stretch="Fill"/>
                            <Image Source="ms-appx:///Assets/Backpack/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill"/>
                            <local:DeferredImage Width="50" Height="50" SourceUri="{x:Bind IconUri}" DecodePixelWidth="64"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="14,0,12,0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource HighlightColor}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{helpers:Loc Key=BackpackWindow_DetailSubtitleSimple}" Foreground="{ThemeResource SubTextColor}" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                            <Border Padding="12,3" CornerRadius="6" Background="{ThemeResource BadgeBackgroundBrush}" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind Count}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="OverviewKpiTemplate" x:DataType="vm:BackpackKpiItem">
                    <Grid Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource HighlightColor}"/>
                            <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource SubTextColor}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{x:Bind Value}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource HighlightColor}" VerticalAlignment="Center"/>
                        <Rectangle Grid.Row="2" Height="2" Fill="{ThemeResource SeparatorBrush}" Margin="0,4,0,0"/>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="OverviewInsightTemplate" x:DataType="vm:BackpackInsightItem">
                    <Grid Padding="0,0,0,12" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{ThemeResource HighlightColor}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Bind Title}" Foreground="{ThemeResource HighlightColor}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{x:Bind Body}" Foreground="{ThemeResource SubTextColor}" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="OverviewCultivationTemplate" x:DataType="vm:BackpackPlanItem">
                    <Grid Padding="0,0,0,8" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource HighlightColor}" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind OwnedText}" Foreground="{ThemeResource SubTextColor}" FontSize="11"/>
                        </Grid>
                        <ProgressBar Grid.Row="1" Value="{x:Bind Progress}" Maximum="100" Height="4" Foreground="{ThemeResource HighlightColor}" Background="{ThemeResource BadgeBackgroundBrush}"/>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="OverviewCookingTemplate" x:DataType="vm:BackpackCookingItem">
                    <Grid Padding="0,0,0,8" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="36" Height="36" CornerRadius="8">
                            <Image Source="{x:Bind QualitySource}" Stretch="Fill"/>
                            <Image Source="ms-appx:///Assets/Backpack/Quality/UI_ImgSign_ItemIcon.png" Stretch="Fill"/>
                            <local:DeferredImage Width="32" Height="32" SourceUri="{x:Bind IconUri}" DecodePixelWidth="40"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource HighlightColor}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind MissingText}" Foreground="{ThemeResource SubTextColor}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Padding="8,3" CornerRadius="6" Background="{ThemeResource BadgeBackgroundBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Status}" FontSize="10" Foreground="{ThemeResource HighlightColor}"/>
                        </Border>
                    </Grid>
                </DataTemplate>

                <Storyboard x:Key="DetailSlideInStoryboard">
                    <DoubleAnimation Storyboard.TargetName="DetailTransform" Storyboard.TargetProperty="X" From="380" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="DetailPane" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24"/>
                </Storyboard>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="/Assets/WindowIcon.ico" Width="16" Height="16" Margin="0,0,12,0"/>
                <TextBlock Text="{helpers:Loc Key=BackpackWindow_Archive}" FontSize="12" Foreground="{ThemeResource SubTextColor}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="16,0" BorderBrush="{ThemeResource CardBorder}" BorderThickness="0,0,0,1" Background="{ThemeResource SidebarBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Button Click="OnToggleDetailPane" Style="{StaticResource ToolbarButtonStyle}" ToolTipService.ToolTip="{helpers:Loc Key=BackpackWindow_Title}">
                    <FontIcon Glyph="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                </Button>

                <Border Padding="10,4" CornerRadius="4" Background="{ThemeResource BadgeBackgroundBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{ThemeResource SubTextColor}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalCollectedText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{x:Bind ViewModel.SummaryStats, Mode=OneWay}" ItemTemplate="{StaticResource BackpackSummaryStatTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <AutoSuggestBox Grid.Column="1" PlaceholderText="{helpers:Loc Key=BackpackWindow_SearchPlaceholder}"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            QueryIcon="Find" Margin="20,0" MaxWidth="400" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.BrowseVisibility, Mode=OneWay}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleSwitch IsOn="{x:Bind ViewModel.HideEmpty, Mode=TwoWay}"
                              OnContent="{helpers:Loc Key=BackpackWindow_VisibilityOn}"
                              OffContent="{helpers:Loc Key=BackpackWindow_VisibilityOff}"
                              MinWidth="120" VerticalAlignment="Center"
                              Visibility="{x:Bind ViewModel.BrowseVisibility, Mode=OneWay}"/>

                <Button Click="OnImportBackpackClick" Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=BackpackWindow_ImportBackpack}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE118;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                        <TextBlock Text="{helpers:Loc Key=BackpackWindow_ImportBackpack}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Click="OnExportBackpackClick" Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=BackpackWindow_ExportBackpack}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE11C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                        <TextBlock Text="{helpers:Loc Key=BackpackWindow_ExportBackpack}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Click="OnRefreshDataClick" Style="{StaticResource ToolbarButtonStyle}"
                        ToolTipService.ToolTip="{helpers:Loc Key=BackpackWindow_RefreshData}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                        <TextBlock Text="{helpers:Loc Key=BackpackWindow_RefreshData}" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Border Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="4" Padding="10,4" Margin="6,0,0,0"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ProfileBadge, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE779;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{ThemeResource SubTextColor}"/>
                        <TextBlock Text="{x:Bind ViewModel.ProfileBadge, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource HighlightColor}" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{ThemeResource SidebarBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="0,0,1,0">
                <Grid Padding="0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="14,8,14,4" Spacing="6">
                        <Border Background="{ThemeResource BadgeBackgroundBrush}" Padding="10,6" CornerRadius="6">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{ThemeResource SubTextColor}"/>
                                    <TextBlock Text="{x:Bind ViewModel.GamePathDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource HighlightColor}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.GameStatusLabel, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SubTextColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SidebarTabs, Mode=OneWay}"
                              ItemContainerStyle="{StaticResource SidebarListItemContainerStyle}"
                              ItemTemplate="{StaticResource BackpackSidebarItemTemplate}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnSidebarItemClick"
                              Background="Transparent"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="4" Visibility="{x:Bind ViewModel.OverviewVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                            <TextBlock Text="{helpers:Loc Key=Backpack_PageSubtitle}" FontSize="12" Foreground="{ThemeResource SubTextColor}"/>
                        </StackPanel>

                        <Grid Grid.Row="1" ColumnSpacing="14" RowSpacing="14" Visibility="{x:Bind ViewModel.OverviewVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl Grid.ColumnSpan="4" ItemsSource="{x:Bind ViewModel.OverviewKpis, Mode=OneWay}" ItemTemplate="{StaticResource OverviewKpiTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="130" MaximumRowsOrColumns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="14" Visibility="{x:Bind ViewModel.OverviewVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{helpers:Loc Key=Backpack_SectionInsights}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                    <Rectangle Height="1" Fill="{ThemeResource SeparatorBrush}"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.OverviewInsights, Mode=OneWay}" ItemTemplate="{StaticResource OverviewInsightTemplate}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{helpers:Loc Key=Backpack_SectionCultivation}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                    <Rectangle Height="1" Fill="{ThemeResource SeparatorBrush}"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CultivationPlan, Mode=OneWay}" ItemTemplate="{StaticResource OverviewCultivationTemplate}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3" Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18"
                                Visibility="{x:Bind ViewModel.OverviewVisibility, Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{helpers:Loc Key=Backpack_CookHeader}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                <Rectangle Height="1" Fill="{ThemeResource SeparatorBrush}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CookingItems, Mode=OneWay}" ItemTemplate="{StaticResource OverviewCookingTemplate}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Padding="16" Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="8"
                                Visibility="{x:Bind ViewModel.BrowseVisibility, Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{helpers:Loc Key=Backpack_BrowseTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                    <TextBlock Text="{helpers:Loc Key=Backpack_BrowseCaption}" FontSize="11" Foreground="{ThemeResource SubTextColor}" TextWrapping="Wrap" MaxLines="2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <Border Padding="10,4" CornerRadius="4" Background="{ThemeResource BadgeBackgroundBrush}">
                                        <TextBlock Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource HighlightColor}"/>
                                    </Border>
                                    <Button Click="OnResetBrowse" Style="{StaticResource ToolbarButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                                            <TextBlock Text="{helpers:Loc Key=Backpack_BrowseReset}" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="5" Spacing="6" Visibility="{x:Bind ViewModel.SubcategoryVisibility, Mode=OneWay}">
                            <TextBlock Text="{helpers:Loc Key=Backpack_BrowseSubcategory}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,2">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SubcategoryOptions, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BackpackBrowseChip">
                                            <ToggleButton IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="OnSubcategoryChipClick" Tag="{x:Bind}" Style="{StaticResource ToolbarToggleButtonStyle}">
                                                <TextBlock Text="{x:Bind Label}" FontSize="11"/>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="20" Visibility="{x:Bind ViewModel.BrowseVisibility, Mode=OneWay}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{helpers:Loc Key=Backpack_BrowseFilter}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.FilterOptions, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BackpackBrowseChip">
                                            <ToggleButton IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="OnFilterChipClick" Tag="{x:Bind}" Style="{StaticResource ToolbarToggleButtonStyle}">
                                                <TextBlock Text="{x:Bind Label}" FontSize="11"/>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{helpers:Loc Key=Backpack_BrowseSort}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SortOptions, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BackpackBrowseChip">
                                            <ToggleButton IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="OnSortChipClick" Tag="{x:Bind}" Style="{StaticResource ToolbarToggleButtonStyle}">
                                                <TextBlock Text="{x:Bind Label}" FontSize="11"/>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Spacing="10" Visibility="{x:Bind ViewModel.BrowseVisibility, Mode=OneWay}">
                            <ListView ItemsSource="{x:Bind ViewModel.DisplayWeapons, Mode=OneWay}"
                                      ItemTemplate="{StaticResource CompactWeaponTemplate}"
                                      IsItemClickEnabled="True" ItemClick="OnItemClick"
                                      SelectionMode="None"
                                      ItemContainerStyle="{StaticResource CardListItemContainerStyle}"
                                      Visibility="{x:Bind ViewModel.WeaponsVisibility, Mode=OneWay}"/>

                            <ListView ItemsSource="{x:Bind ViewModel.DisplayArtifacts, Mode=OneWay}"
                                      ItemTemplate="{StaticResource CompactArtifactTemplate}"
                                      IsItemClickEnabled="True" ItemClick="OnItemClick"
                                      SelectionMode="None"
                                      ItemContainerStyle="{StaticResource CardListItemContainerStyle}"
                                      Visibility="{x:Bind ViewModel.ArtifactsVisibility, Mode=OneWay}"/>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayMaterialGroups, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="14"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                            <ItemsRepeater ItemsSource="{Binding Items}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Vertical" Spacing="0"/>
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl ContentTemplate="{StaticResource CompactSimpleTemplate}" Content="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayFoodGroups, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="14"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                            <ItemsRepeater ItemsSource="{Binding Items}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Vertical" Spacing="0"/>
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl ContentTemplate="{StaticResource CompactFoodTemplate}" Content="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayGadgetGroups, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="14"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                            <ItemsRepeater ItemsSource="{Binding Items}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Vertical" Spacing="0"/>
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl ContentTemplate="{StaticResource CompactSimpleTemplate}" Content="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DisplayAssetGroups, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="14"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                            <ItemsRepeater ItemsSource="{Binding Items}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Orientation="Vertical" Spacing="0"/>
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl ContentTemplate="{StaticResource CompactSimpleTemplate}" Content="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <TextBlock Text="{helpers:Loc Key=BackpackWindow_EmptyMessage}" Foreground="{ThemeResource SubTextColor}" HorizontalAlignment="Center" Margin="0,40,0,0"
                                       Visibility="{x:Bind ViewModel.HasNoResultsVisibility, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="DetailPane" Grid.Column="1" Width="380" Background="{ThemeResource AppBackground}"
                      BorderBrush="{ThemeResource CardBorder}" BorderThickness="1,0,0,0"
                      Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="DetailTransform" X="380"/>
                    </Grid.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                        <StackPanel Spacing="14" DataContext="{x:Bind ViewModel.SelectedItem, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource BadgeBackgroundBrush}">
                                    <FontIcon Glyph="{x:Bind ViewModel.DetailGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{ThemeResource HighlightColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubTextColor}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource ToolbarButtonStyle}" Click="OnCloseDetailClick">
                                    <FontIcon Glyph="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                </Button>
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource SeparatorBrush}"/>

                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.WeaponDetailVisibility, Mode=OneWay}">
                                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="{helpers:Loc Key=Backpack_DetailLevel}" FontSize="11" Foreground="{ThemeResource SubTextColor}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source.Level}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="{helpers:Loc Key=Backpack_DetailRefine}" FontSize="11" Foreground="{ThemeResource SubTextColor}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source.RefineLabel}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="{helpers:Loc Key=Backpack_DetailBaseAtk}" FontSize="11" Foreground="{ThemeResource SubTextColor}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source.AtkDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{Binding Source.SubVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{helpers:Loc Key=Backpack_DetailSubStat}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                        <TextBlock Text="{Binding Source.SubDisplay}" FontSize="13" Foreground="{ThemeResource HighlightColor}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{Binding Source.PassiveVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{helpers:Loc Key=Backpack_DetailSkill}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                        <TextBlock Text="{Binding Source.PassiveName}" FontSize="13" Foreground="{ThemeResource HighlightColor}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Source.SkillDesc}" FontSize="12" Foreground="{ThemeResource SubTextColor}" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{Binding Source.FlavorVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{helpers:Loc Key=Backpack_DetailLore}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                        <TextBlock Text="{Binding Source.FlavorText}" FontSize="12" Foreground="{ThemeResource SubTextColor}" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ArtifactDetailVisibility, Mode=OneWay}">
                                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{helpers:Loc Key=Backpack_DetailMainStat}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Source.MainStat.Type}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Source.MainStatValueDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                            </Grid>
                                        </StackPanel>
                                        <Rectangle Height="1" Fill="{ThemeResource SeparatorBrush}"/>
                                        <StackPanel Spacing="6" Visibility="{Binding HasInstanceVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                            <TextBlock Text="{helpers:Loc Key=Backpack_DetailSubStats}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                            <ItemsControl ItemsSource="{Binding SubStatItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SubStatItemViewModel">
                                                        <Grid ColumnSpacing="8" Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{ThemeResource HighlightColor}"/>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ValueDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Spacing="6" Visibility="{Binding Source.HasAnyBonusVisibility, Mode=OneWay, FallbackValue=Collapsed}">
                                            <TextBlock Text="{helpers:Loc Key=Backpack_DetailSetBonus}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                            <TextBlock Text="{Binding Source.BonusText}" FontSize="12" Foreground="{ThemeResource HighlightColor}" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.FoodDetailVisibility, Mode=OneWay}">
                                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding Character}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource HighlightColor}" Visibility="{Binding CharacterVisibility}"/>
                                        <Rectangle Height="1" Fill="{ThemeResource SeparatorBrush}"/>
                                        <TextBlock Text="{helpers:Loc Key=Backpack_DetailIngredients}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                        <ItemsControl ItemsSource="{Binding Ingredients}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:IngredientViewModel">
                                                    <Grid ColumnSpacing="10" Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="12" Foreground="{ThemeResource HighlightColor}"/>
                                                        <Border Grid.Column="1" Padding="8,2" CornerRadius="4" Background="{ThemeResource BadgeBackgroundBrush}">
                                                            <TextBlock Text="{x:Bind HeldText}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.SimpleDetailVisibility, Mode=OneWay}">
                                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{helpers:Loc Key=Backpack_DetailCountLabel}" FontSize="11" Foreground="{ThemeResource SubTextColor}"/>
                                            <TextBlock Text="{helpers:Loc Key=Backpack_DetailCountBody}" FontSize="12" Foreground="{ThemeResource SubTextColor}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource HighlightColor}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Click="OnCloseDetailClick" Style="{StaticResource ToolbarButtonStyle}" Padding="10,6" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                                        <TextBlock Text="{helpers:Loc Key=BackpackWindow_CloseDetail}" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnViewGuideClick" Style="{StaticResource ToolbarButtonStyle}" Padding="10,6" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
